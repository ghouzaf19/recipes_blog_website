{
  "name": "cooketricks-frontend",
  "version": "2.0.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test:profile",
    "content:dry-run": "node --experimental-strip-types scripts/dry-run-topical-authority.mts",
    "test:content-import": "node --experimental-strip-types --test scripts/dry-run-topical-authority.test.mts",
    "test:profile": "node --experimental-strip-types --test scripts/cooketricks-profile.test.mts"
  },
  "dependencies": {
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
